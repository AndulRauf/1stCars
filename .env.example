# ==============================================================
# 1stCars Environment Variables
# --------------------------------------------------------------
# Copy this file to ".env" (or ".env.local") and fill in the
# values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# NOTE: Only variables prefixed with VITE_ are exposed to the
# client bundle by Vite. Never put secret/service-role keys here.
# ==============================================================

# Your Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Your Supabase "anon" public API key (safe for the browser)
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Google Analytics 4 Measurement ID (optional — if unset, GA4 falls back to the
# CMS "googleAnalyticsId" website setting editable in AdminCMS). Must be a real
# ID in the format G-XXXXXXXXXX. Example: G-ABCDE12345
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel ID (optional — if unset, the production Pixel ID is used).
# Example: 123456789012345
VITE_META_PIXEL_ID=YOUR_META_PIXEL_ID

# --------------------------------------------------------------
# How the app decides between REAL vs MOCK database:
#   - If BOTH values above are set -> real Supabase is used.
#   - If either is empty          -> an in-browser localStorage
#                                     mock is used (demo only).
# NOTE: In production builds (npm run build) the runtime mock
# toggle (localStorage "1stcars_use_mock_db") is IGNORED — a
# production build with missing env vars shows a configuration
# error screen instead of silently using fake data.
# --------------------------------------------------------------
