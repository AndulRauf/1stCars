{
  "rewrites": [
    {
      "source": "/cars/:id",
      "destination": "/api/car-preview/:id",
      "missing": [
        { "type": "query", "key": "code" },
        { "type": "query", "key": "state" },
        { "type": "query", "key": "error" },
        { "type": "query", "key": "open_booking" }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
